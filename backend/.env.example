# Neon PostgreSQL pooled connection URL placeholder
DATABASE_URL=postgresql://user:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-64-character-jwt-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://dukaan2door.vercel.app

# Routing service
OSRM_BASE_URL=https://router.project-osrm.org

# Neon PostgreSQL pooled connection URL placeholder. The app also accepts the
# standard postgresql:// URL copied directly from Neon and normalizes it.
DATABASE_URL=postgresql+psycopg2://user:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-64-character-jwt-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://dukaan2door.vercel.app

# Routing service
OSRM_BASE_URL=https://router.project-osrm.org
# Optional browser-independent OSRM movement for controlled walkthroughs.
ENABLE_ROUTE_PLAYBACK=false
ROUTE_PLAYBACK_SPEED_KMH=40
ROUTE_PLAYBACK_UPDATE_SECONDS=2.5
PICKUP_DWELL_SECONDS=120

# Server-side OCR inventory analysis (optimized for CPU speed)
PADDLE_OCR_DETECTION_MODEL=PP-OCRv6_small_det
PADDLE_OCR_RECOGNITION_MODEL=PP-OCRv6_medium_rec
PADDLE_OCR_CPU_THREADS=4
PADDLE_OCR_MAX_IMAGE_SIDE=1600
PADDLE_OCR_MAX_IMAGE_PIXELS=25000000
PADDLE_OCR_MAX_PDF_PAGES=10
PADDLE_OCR_LOW_CONFIDENCE=0.70
PADDLE_OCR_COMPARE_PREPROCESSED=false
PADDLE_OCR_USE_ORIENTATION=false

# Optional: Add a Google Gemini API key for multimodal inventory extraction.
# Results always require retailer review before inventory is updated.
# Falls back automatically to local PaddleOCR if unset or during network errors.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite

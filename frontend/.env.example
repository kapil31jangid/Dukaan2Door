# Backend API Base URL (empty for Vite proxy relative URL)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
# Public Mapbox browser token (pk...). Restrict it to the deployed frontend origins.
VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token_here
# Store catalog shown in the customer demo. Match this to the retailer account under test.
VITE_CUSTOMER_STORE_ID=29

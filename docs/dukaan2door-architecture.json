  "cards": [
    {
      "dot": "rose",
      "title": "Order path",
      "items": [
        "Every stock-qualified retailer receives an offer; the first valid acceptance owns fulfilment.",
        "Only READY_FOR_PICKUP orders enter the eligible rider pool; one atomic claim wins.",
        "Pickup and delivery remain backend-authorized lifecycle transitions."
      ]
    },
    {
      "dot": "emerald",
      "title": "Tracking path",
      "items": [
        "The backend requests one OSRM road route for each active leg and persists each point.",
        "Movement continues independently of the rider browser tab and resumes after backend restart.",
        "Authenticated WebSocket snapshots and events keep rider and customer maps synchronized."
      ]
    },
    {
      "dot": "cyan",
      "title": "Inventory safety",
      "items": [
        "Gemini or PaddleOCR produces review-only candidates; analysis never changes stock.",
        "Retailer confirmation controls catalog matching and positive or negative adjustments.",
        "PostgreSQL remains authoritative for offers, stock, orders, deliveries, and tracking."
      ]
    }
  ]

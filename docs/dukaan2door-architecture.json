  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Runtime Path",
      "items": [
        "A role-specific React portal sends an authenticated command to FastAPI.",
        "Commerce Core validates catalogue, location, store eligibility, price, and stock before one PostgreSQL transaction.",
        "Neon remains authoritative for users, products, store inventory, orders, deliveries, and tracking history."
      ]
    },
    {
      "dot": "violet",
      "title": "Inventory Onboarding",
      "items": [
        "Gemini returns structured inventory candidates; local PaddleOCR remains a provider fallback.",
        "Analysis never writes stock. Retailers edit or remove candidates before confirmation.",
        "Confirmation uses store ownership checks, exact matching, row locks, and adjustment history."
      ]
    },
    {
      "dot": "emerald",
      "title": "Fulfilment & Live Tracking",
      "items": [
        "Retailer progression ends at READY_FOR_PICKUP; eligible riders then claim atomically.",
        "Delivery state, rejection, capability checks, and GPS breadcrumbs are backend-authoritative.",
        "OSRM supplies road geometry while the in-memory WebSocket hub fans live events back to connected portals."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries",
      "items": [
        "Browser input and public map tokens are untrusted; JWT identity and role checks execute server-side.",
        "Database and Gemini credentials stay inside the backend runtime.",
        "Gemini, Mapbox, and OSRM are independent external providers; provider failure must not bypass domain validation."
      ]
    }
  ]
}
